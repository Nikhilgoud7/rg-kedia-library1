{
  "name": "rg-kedia-library",
  "version": "1.0.0",
  "description": "R.G. Kedia College of Commerce - Library Management System",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "cd client && npm run dev",
    "build": "npm run prisma:generate && npm run build:client && npm run build:server",
    "build:client": "npm --prefix client run build",
    "build:server": "tsc",
    "start": "node dist/server/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "demo:reset": "tsx scripts/demoReset.ts",
    "notifications:retention": "tsx server/jobs/retention.ts",
    "backup:create": "tsx scripts/backup.ts",
    "backup:verify": "tsx scripts/verifyBackup.ts",
    "backup:restore": "tsx scripts/restore.ts",
    "cohort:validate": "tsx scripts/validateCohort.ts",
    "credentials:generate": "tsx scripts/generateCredentials.ts",
    "migration:simulate": "tsx scripts/simulateMigration.ts",
    "demo:purge": "tsx scripts/purgeDemoAccounts.ts",
    "test": "node tests/runner.js --allow-tests",
    "test:auth": "node tests/runner.js --allow-tests --suite=auth",
    "test:authorization": "node tests/runner.js --allow-tests --suite=authorization",
    "test:lending": "node tests/runner.js --allow-tests --suite=lending",
    "test:concurrency": "node tests/runner.js --allow-tests --suite=concurrency",
    "test:notification": "node tests/runner.js --allow-tests --suite=notification",
    "test:demo": "node tests/runner.js --allow-tests --suite=demo",
    "test:audit": "node tests/runner.js --allow-tests --suite=audit",
    "test:user-hardening": "node tests/runner.js --allow-tests --suite=userHardening",
    "test:lending-queue": "node tests/runner.js --allow-tests --suite=lendingQueue",
    "test:exam-guide": "node tests/runner.js --allow-tests --suite=examGuide",
    "test:librarian-polish": "node tests/runner.js --allow-tests --suite=librarianPolish",
    "test:copy-management": "node tests/runner.js --allow-tests --suite=copyManagement",
    "test:reconciliation": "node tests/runner.js --allow-tests --suite=inventoryReconciliation",
    "test:lost-damaged": "node tests/runner.js --allow-tests --suite=lostDamaged",
    "test:inventory-experience": "node tests/runner.js --allow-tests --suite=inventoryExperience",
    "test:inventory-circulation": "node tests/runner.js --allow-tests --suite=inventoryCirculation",
    "test:cross-persona-inventory": "node tests/runner.js --allow-tests --suite=crossPersonaInventory",
    "test:inventory-final-gate": "node tests/runner.js --allow-tests --suite=inventoryFinalGate",
    "test:bulk-import-foundation": "node tests/runner.js --allow-tests --suite=bulkImportFoundation",
    "test:bulk-import-execution": "node tests/runner.js --allow-tests --suite=bulkImportExecution",
    "test:bulk-import-ui": "node tests/runner.js --allow-tests --suite=bulkImportUIWorkflow",
    "test:bulk-import-final-gate": "node tests/runner.js --allow-tests --suite=bulkImportFinalGate",
    "test:bulk-export": "node tests/runner.js --allow-tests --suite=bulkExport",
    "test:env-guard": "node tests/runner.js --allow-tests --suite=envGuardValidation",
    "test:storage": "node tests/runner.js --allow-tests --suite=storageAdapter",
    "test:cover-api": "node tests/runner.js --allow-tests --suite=bookCoverApi",
    "test:cover-ui": "node tests/runner.js --allow-tests --suite=bookCoverUIWorkflow",
    "test:data-export": "node tests/runner.js --allow-tests --suite=dataExport",
    "test:password-change": "node tests/runner.js --allow-tests --suite=mandatoryPasswordChange",
    "test:backup": "node tests/runner.js --allow-tests --suite=backupRecovery",
    "test:cohort": "node tests/runner.js --allow-tests --suite=syntheticCohort",
    "test:migration": "node tests/runner.js --allow-tests --suite=migrationSimulation",
    "test:demo-purge": "node tests/runner.js --allow-tests --suite=demoPurge",
    "test:audit-foundation": "node tests/runner.js --allow-tests --suite=auditFoundation",
    "test:audit-mq": "node tests/runner.js --allow-tests --suite=auditMonthlyQuarterly",
    "test:audit-inventory": "node tests/runner.js --allow-tests --suite=auditPhysicalInventory",
    "test:audit-discrepancy": "node tests/runner.js --allow-tests --suite=auditDiscrepancyManagement",
    "test:audit-annual": "node tests/runner.js --allow-tests --suite=auditAnnualInstitutional",
    "test:audit-integration": "node tests/runner.js --allow-tests --suite=auditFinalIntegration",
    "test:audit-route": "node tests/runner.js --allow-tests --suite=auditRoute",
    "test:audit-all": "node tests/runner.js --allow-tests --suite=auditFoundation,auditMonthlyQuarterly,auditPhysicalInventory,auditDiscrepancyManagement,auditAnnualInstitutional,auditFinalIntegration,auditRoute"
  },
  "dependencies": {
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.2",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/express-serve-static-core": "^4.19.9",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "concurrently": "^9.1.2",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
