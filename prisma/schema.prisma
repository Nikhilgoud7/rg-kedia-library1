// R.G. Kedia College of Commerce - Library Management System
// Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── Users ──────────────────────────────────────────────

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  password       String
  role           String   @default("STUDENT") // STUDENT | TEACHER | LIBRARIAN
  rollNumber     String?  @unique
  program        String?  // BCOM | BBA | BSC
  branch         String?  // e.g., "General", "Computer Applications", etc.
  year           Int?     // 1, 2, or 3
  semester       Int?     // 1-6
  secondLanguage String?  // TELUGU | SANSKRIT | ARABIC | HINDI
  phone               String?
  gender              String?   // MALE | FEMALE | OTHER
  approvalStatus      String    @default("APPROVED") // PENDING | APPROVED | REJECTED
  approvedAt          DateTime?
  approvedById        String?
  rejectionReason     String?
  active              Boolean   @default(true)
  mustChangePassword  Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  tokenVersion        Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  lendings           Lending[]
  bookRequests       BookRequest[]
  examPapersUploaded ExamPaper[]
  notifications      Notification[]
  auditLogs              AuditLog[]
  auditsLed              LibraryAudit[]
  inventoryScans         InventoryAuditScan[]
  auditActionsPerformed  AuditCorrectiveAction[]

  @@index([approvalStatus])
  @@index([role, approvalStatus])
}

// ─── Books ──────────────────────────────────────────────

model Book {
  id              String   @id @default(uuid())
  title           String
  author          String
  isbn            String?
  publisher       String?
  edition         String?
  publicationYear Int?
  category        String   @default("TEXTBOOK") // TEXTBOOK | REFERENCE | GENERAL | LANGUAGE | JOURNAL
  segment         String   // e.g., "Accounting", "Statistics", "English Literature"
  description     String?
  totalCopies     Int      @default(1)
  availableCopies Int      @default(1)
  shelfLocation   String?  // e.g., "A-3-12" (Rack A, Shelf 3, Position 12)
  coverImage      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  copies       BookCopy[]
  requests     BookRequest[]
  bookPrograms BookProgram[]
  cover              BookCover?
  auditDiscrepancies AuditDiscrepancy[]
}

// Dedicated binary cover image storage
model BookCover {
  id        String   @id @default(uuid())
  bookId    String   @unique
  data      Bytes
  mimeType  String   @default("image/webp")
  sizeBytes Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

// Maps books to programs/branches they're relevant for
model BookProgram {
  id      String  @id @default(uuid())
  bookId  String
  program String  // BCOM | BBA | BSC
  branch  String? // specific branch or null for all branches in program

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, program, branch])
}

// Individual physical copies of a book
model BookCopy {
  id            String  @id @default(uuid())
  bookId        String
  copyNumber    Int
  condition     String  @default("Good") // Good | Fair | Poor | Damaged
  status        String  @default("AVAILABLE") // AVAILABLE | ISSUED | RESERVED | LOST | DAMAGED | WITHDRAWN
  barcode       String? @unique
  shelfLocation String?

  book     Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  lendings           Lending[]
  inventoryScans     InventoryAuditScan[]
  auditDiscrepancies AuditDiscrepancy[]

  @@unique([bookId, copyNumber])
  @@index([status])
  @@index([bookId, status, condition])
}

// ─── Lending System ─────────────────────────────────────

model Lending {
  id           String    @id @default(uuid())
  userId       String
  bookCopyId   String
  issuedDate   DateTime  @default(now())
  dueDate      DateTime
  returnedDate DateTime?
  status       String    @default("ISSUED") // ISSUED | RETURNED | OVERDUE
  fine         Float     @default(0)
  renewalCount Int       @default(0)
  issuedById   String?   // Librarian who issued
  notes        String?
  createdAt    DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id])
  bookCopy BookCopy @relation(fields: [bookCopyId], references: [id])

  @@index([issuedDate, status])
  @@index([dueDate, status])
}

model BookRequest {
  id             String   @id @default(uuid())
  userId         String
  bookId         String
  type           String   // BORROW | RETURN_REQUEST
  status         String   @default("PENDING") // PENDING | APPROVED | REJECTED
  message        String?
  responseMessage String?
  respondedById  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  book Book @relation(fields: [bookId], references: [id])
}

// ─── Exam Guide ─────────────────────────────────────────

model ExamPaper {
  id               String    @id @default(uuid())
  title            String
  subject          String
  program          String   // BCOM | BBA | BSC
  branch           String   // specific branch
  year             Int      // academic year (e.g., 2024)
  semester         Int      // 1-6
  type             String   // PREVIOUS_YEAR | IMPORTANT_QUESTIONS | STUDY_GUIDE
  fileUrl          String   // path to uploaded file or fallback URL
  description      String?
  uploadedById     String
  storageProvider  String    @default("local") // local | r2 | s3
  storageKey       String?   // object key in storage bucket or relative disk path
  originalFileName String?   // original human-readable filename uploaded by faculty
  mimeType         String?   // validated MIME type (e.g. application/pdf)
  fileSizeBytes    Int?      // size in bytes
  checksum         String?   // SHA-256 digest for integrity & migration verification
  publishedAt      DateTime? // null = pending review / unpublished; timestamp = published
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([publishedAt])
  @@index([storageProvider])
}

// ─── Notifications ──────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   // INFO | WARNING | OVERDUE | REQUEST | APPROVAL
  read      Boolean  @default(false)
  link      String?
  dismissedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─── Audit Log ──────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  action    String   // USER_CREATED | USER_UPDATED | USER_DEACTIVATED | USER_ACTIVATED | PASSWORD_RESET | USER_DELETED | BOOK_CREATED | BOOK_UPDATED | BOOK_DELETED | BOOK_COPY_UPDATED | BOOK_COPY_CREATED | BOOK_COPY_DELETED | BOOK_COPY_LOST | BOOK_COPY_DAMAGED | BOOK_COPY_WITHDRAWN
  targetId  String?
  details   String?
  timestamp DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([action])
  @@index([timestamp])
}


// ─── Phase 11: Institutional Audit & Operations Management ──────

model LibraryAudit {
  id              String    @id @default(uuid())
  auditNumber     String    @unique // e.g. "AUD-2026-M10-001"
  type            String    // MONTHLY | QUARTERLY | SEMI_ANNUAL_INVENTORY | ANNUAL
  title           String
  periodStart     DateTime
  periodEnd       DateTime
  academicYear    String?   // e.g. "2026-2027"
  status          String    @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | PENDING_RECONCILIATION | COMPLETED | CLOSED
  leadLibrarianId String
  observations    String?
  recommendations String?
  snapshotData    String?   // Frozen JSON snapshot upon completion
  completedAt     DateTime?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  leadLibrarian    User                   @relation(fields: [leadLibrarianId], references: [id], onDelete: Restrict)
  inventorySession InventoryAuditSession?
  discrepancies    AuditDiscrepancy[]

  @@index([type, status])
  @@index([periodStart, periodEnd])
  @@index([academicYear])
}

model InventoryAuditSession {
  id               String    @id @default(uuid())
  auditId          String    @unique
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  totalExpected    Int       @default(0)
  totalScanned     Int       @default(0)
  totalMatched     Int       @default(0)
  totalMissing     Int       @default(0)
  totalIssued      Int       @default(0)
  totalSurplus     Int       @default(0)
  totalDiscrepancy Int       @default(0)
  status           String    @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED | ABORTED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  audit LibraryAudit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  scans InventoryAuditScan[]

  @@index([status])
}

model InventoryAuditScan {
  id           String   @id @default(uuid())
  sessionId    String
  barcode      String
  bookCopyId   String?
  scannedAt    DateTime @default(now())
  scannedById  String
  matchStatus  String   // MATCHED | SHELF_MISMATCH | STATUS_CONFLICT | UNREGISTERED
  scannedShelf String?
  notes        String?

  session   InventoryAuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  scannedBy User                  @relation(fields: [scannedById], references: [id], onDelete: Restrict)
  bookCopy  BookCopy?             @relation(fields: [bookCopyId], references: [id], onDelete: SetNull)

  @@unique([sessionId, barcode])
  @@index([sessionId, matchStatus])
}

model AuditDiscrepancy {
  id              String    @id @default(uuid())
  auditId         String
  bookId          String?
  bookCopyId      String?
  barcode         String?
  category        String    // MISSING_PHYSICAL_BOOK | DAMAGED_BOOK | INCORRECT_BARCODE | DUPLICATE_BARCODE | INCORRECT_SHELF_LOCATION | INVENTORY_COUNT_MISMATCH | UNREGISTERED_PHYSICAL_BOOK | INCORRECT_STATUS | OTHER
  severity        String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  description     String
  discoveredDate  DateTime  @default(now())
  status          String    @default("OPEN") // OPEN | UNDER_INVESTIGATION | ACTION_REQUIRED | RESOLVED | CLOSED
  resolutionNotes String?
  resolvedAt      DateTime?
  resolvedById    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  audit             LibraryAudit            @relation(fields: [auditId], references: [id], onDelete: Cascade)
  book              Book?                   @relation(fields: [bookId], references: [id], onDelete: SetNull)
  bookCopy          BookCopy?               @relation(fields: [bookCopyId], references: [id], onDelete: SetNull)
  correctiveActions AuditCorrectiveAction[]

  @@index([auditId, status])
  @@index([category])
}

model AuditCorrectiveAction {
  id              String   @id @default(uuid())
  discrepancyId   String
  actionTaken     String
  actionDate      DateTime @default(now())
  performedById   String
  resultingStatus String?
  notes           String?
  createdAt       DateTime @default(now())

  discrepancy AuditDiscrepancy @relation(fields: [discrepancyId], references: [id], onDelete: Cascade)
  performedBy User             @relation(fields: [performedById], references: [id], onDelete: Restrict)

  @@index([discrepancyId])
}
