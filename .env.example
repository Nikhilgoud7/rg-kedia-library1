# R.G. Kedia College Library - Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (SQLite in development, PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# JWT Authentication
# Must be at least 32 characters. Generate using: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Trust Proxy (set number of reverse proxy hops when deployed behind Render, Railway, Nginx, etc.)
# TRUST_PROXY=1
