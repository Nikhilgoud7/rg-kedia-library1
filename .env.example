# R.G. Kedia College Library - Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL via Neon)
# Main development / production pooled connection (routes through PgBouncer)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct unpooled connection for Prisma schema migrations and DDL operations
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require"

# Dedicated Isolated Test Database (required for automated regression test runs)
# Must point to an isolated test database or dedicated Neon test branch, never production.
TEST_DATABASE_URL="postgresql://user:password@ep-test-pooler.region.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication
# Must be at least 32 characters. Generate using: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# File Uploads (Local disk in development)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Cloud Object Storage (Cloudflare R2 — Mandatory in Production)
# In development/test: STORAGE_DRIVER=local (uses local disk uploads/exam-papers)
# In production: STORAGE_DRIVER=r2 (fail-fast guard blocks startup if unset or set to local)
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=rg-kedia-library-exam-papers
# Optional override for custom S3/R2 endpoints (defaults to https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com)
# R2_ENDPOINT=
# R2_REGION=auto

# Trust Proxy (set number of reverse proxy hops when deployed behind Render, Railway, Nginx, etc.)
# TRUST_PROXY=1
