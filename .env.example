# R.G. Kedia College Library - Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL via Neon)
# Main development / production connection
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require"

# Dedicated Isolated Test Database (required for automated regression test runs)
# Must point to an isolated test database or dedicated Neon test branch, never production.
TEST_DATABASE_URL="postgresql://user:password@ep-test-pooler.region.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication
# Must be at least 32 characters. Generate using: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Trust Proxy (set number of reverse proxy hops when deployed behind Render, Railway, Nginx, etc.)
# TRUST_PROXY=1
